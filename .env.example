# QMS Hub Environment Variables Example
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.railway.app

# Database URL: Leave empty for local SQLite, or provide PostgreSQL connection string:
# DATABASE_URL=postgres://user:password@host:port/dbname
DATABASE_URL=
